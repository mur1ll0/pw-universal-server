# Contexto do Dockerfile.recursos (B233): só o que o build usa (ver Dockerfile.core.dockerignore).
**

!Cargo.toml
!Cargo.lock
!crates/
!crates/**
!tools/
!tools/**

# Os specs que o pw-data-loader embute (mesma lista do Dockerfile.core.dockerignore).
!specs/elements_layouts/
!specs/elements_layouts/**
!specs/estudio/referencias.json
!specs/estudio/rotulos.json
!specs/estudio/funcoes_de_conversa.json
!specs/elements_155/realm_155_overrides.json
!specs/elements_155/realm_155_v159_overrides.json
!specs/mapas/
!specs/mapas/**
!specs/habilidades_155/habilidades.json
!specs/habilidades_126/habilidades.json
!specs/addons_155/addons.json
!specs/addons_155/classificacao.json

# O launcher (Tauri) compila fora do Docker; o target dele tem GB (B234).
tools/pw-launcher/target
