# pw-recursos (B233): versão 0 dos clientes, pacotes de instalação assinados e o HTTP do
# atualizador. Diferente do Dockerfile.core: a imagem leva Python 3 e o extrator de .pck já
# validado (tools/pw-pck-extract), que a importação usa — o pw-recursos não lê .pck sozinho.
FROM rust:slim-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY tools ./tools
# O pw-data-loader (Estúdio, B237) embute layouts e tabelas de specs/ com include_str!: os
# mesmos COPY do Dockerfile.core.
COPY specs/elements_layouts ./specs/elements_layouts
COPY specs/estudio/referencias.json ./specs/estudio/referencias.json
COPY specs/estudio/rotulos.json ./specs/estudio/rotulos.json
COPY specs/estudio/funcoes_de_conversa.json ./specs/estudio/funcoes_de_conversa.json
COPY specs/elements_155/realm_155_overrides.json ./specs/elements_155/realm_155_overrides.json
COPY specs/elements_155/realm_155_v159_overrides.json ./specs/elements_155/realm_155_v159_overrides.json
COPY specs/mapas ./specs/mapas
COPY specs/habilidades_155/habilidades.json ./specs/habilidades_155/habilidades.json
COPY specs/habilidades_155/elementskill_v156_tabelas.json ./specs/habilidades_155/elementskill_v156_tabelas.json
COPY specs/habilidades_126/habilidades.json ./specs/habilidades_126/habilidades.json
COPY specs/habilidades_126/elementskill_126_tabelas.json ./specs/habilidades_126/elementskill_126_tabelas.json
COPY specs/addons_155/addons.json ./specs/addons_155/addons.json
COPY specs/addons_155/classificacao.json ./specs/addons_155/classificacao.json
RUN cargo build --release -p pw-recursos

FROM debian:bookworm-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/pw-recursos /app/pw-recursos
COPY tools/pw-pck-extract/pw_pck_extract.py /opt/pw-pck-extract/pw_pck_extract.py
ENV TZ=America/Sao_Paulo \
    PW_RECURSOS_DADOS=/dados \
    PW_RECURSOS_PORTA=8100 \
    PW_RECURSOS_CHAVE=/chave/assinatura_ed25519.key \
    PW_PCK_EXTRACT=/opt/pw-pck-extract/pw_pck_extract.py \
    PYTHON=python3
EXPOSE 8100
ENTRYPOINT ["/app/pw-recursos"]
CMD ["servir"]
